{
  "exclude": [".vscode", "node_modules", "configs", "dist", "test", "examples", "lib", "static"],
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "pretty": true,
    "sourceMap": true,
    "outDir": "",
    "importHelpers": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationDir": "lib",
    "lib": [
      "es2020",
      "dom"
    ]
  }
}
